{
  "name": "@chamoux/diorama",
  "version": "0.0.1",
  "description": "Persistent WebGL scenes and scroll choreography for Inertia + Vue apps.",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": { "node": ">=20.19" },
  "keywords": [
    "inertia", "inertiajs", "vue", "vue3", "laravel",
    "three", "threejs", "three.js", "webgl", "gsap", "scrolltrigger",
    "persistent-canvas", "persistent-layout", "scene", "scroll", "scroll-animation",
    "spa", "3d"
  ],
  "license": "MIT",
  "author": "chamoux",
  "repository": { "type": "git", "url": "git+https://github.com/chamoux/diorama.git" },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4",
    "three": ">=0.160",
    "gsap": "^3.12",
    "@inertiajs/vue3": "^1 || ^2 || ^3"
  },
  "peerDependenciesMeta": {
    "@inertiajs/vue3": { "optional": true }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7",
    "@vitejs/plugin-vue": "^5",
    "@vue/language-core": "~3.1.5",
    "@inertiajs/vue3": "^3",
    "gsap": "^3.13",
    "jsdom": "^25",
    "three": "^0.169",
    "@types/three": "^0.169",
    "typescript": "^5",
    "unplugin-dts": "^1",
    "vite": "^7",
    "vitest": "^3",
    "vue": "^3.5",
    "vue-tsc": "^2"
  },
  "publishConfig": { "access": "public" }
}
